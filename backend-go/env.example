# Local development backend environment (DEV ONLY).
#
# This file is loaded by scripts/dev.sh and is meant for a SEPARATE "dev" cloud
# database, NOT the production database used by the Vercel deployment.
# Keep production and local development on isolated MongoDB Atlas clusters and
# Upstash Redis instances so local testing never touches real user data.
#
# Copy this file to backend-go/.env and fill in your DEV cloud values.
# backend-go/.env is gitignored and must never contain production secrets.

# DEV MongoDB Atlas cluster (a separate cluster from production).
MONGO_URI=mongodb+srv://<dev-user>:<dev-password>@<dev-cluster>/yuna_chat?retryWrites=true&w=majority

# DEV Upstash Redis instance (TLS enabled, separate from production).
REDIS_ADDR=<dev-host>:6379
REDIS_USERNAME=<dev-username>
REDIS_PASSWORD=<dev-password>
REDIS_TLS=true

DATABASE_NAME=yuna_chat
SERVER_ADDR=:8080
ALLOWED_ORIGINS=*
ADMIN_TOKEN=change-me-dev
