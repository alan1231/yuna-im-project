{
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 3 */4 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/keepalive",
      "destination": "https://yuna-im-project.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
